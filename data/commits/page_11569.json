[{"repo_name":"dotnet/WatsonWebserver","commit_timestamp":"2026-10-03T17:59:13Z","branch":"main","commit_sha":"6bdf5da1dc7441e607b01b3fcdac23050eb8af0a","github_link":"https://github.com/dotnet/WatsonWebserver/commit/6bdf5da1dc7441e607b01b3fcdac23050eb8af0a","commit_subject":"Version Watson.Clients in lockstep with Watson (7.2.2)","ai_tool":"Claude"},{"repo_name":"BasedHardware/omi","commit_timestamp":"2026-10-03T17:59:01Z","branch":"main","commit_sha":"d6252a2b34b16762cd99bf2184cf450bf06878f7","github_link":"https://github.com/BasedHardware/omi/commit/d6252a2b34b16762cd99bf2184cf450bf06878f7","commit_subject":"feat: shared Gemini voice picker and mobile chat read-aloud (#20436)","ai_tool":"Claude,Devin"},{"repo_name":"MatterHackers/agg-sharp","commit_timestamp":"2026-10-03T17:58:37Z","branch":"main","commit_sha":"42de455358cdb3b7bc922dd88293ecc2c32cbcc4","github_link":"https://github.com/MatterHackers/agg-sharp/commit/42de455358cdb3b7bc922dd88293ecc2c32cbcc4","commit_subject":"Icons, images, gradients and pattern fills with translucent pixels drawn in software onto a widget backbuffer now blend correctly: a translucent icon pixel over opaque content shows at its real strength instead of too light (grey 51 at alpha 150 over white is 135, was 156), and over transparent content it stores its own straight colour so the composited widget matches a direct draw. ImageGraphics2D sends image draws (DrawImage, every quality path) and the gradient, pattern and filtered-image fills through StraightOverDestination, whose StraightOverImageProxy now blends colour spans straight-over too, under the destination's clip box. Two consumers that relied on the old premultiplied blit follow the straight rule: a rounded backbuffer's clipped corner fades only its alpha (RoundedClipCoverage.Apply; it darkened the colour too, which a straight reader showed as a dark rim), and a faded backbuffer composited by the CPU is built straight (WidgetBackbuffer.DestinationBlendsPremultiplied is now true only for LcdBufferGraphics2D), so half opacity lands half way instead of dark. New ImageGraphics2DTranslucentImageTests: whole-pixel, scaled and fractional draws over opaque white, the same on a transparent backbuffer composited against a direct draw, translucent gradient and pattern fills, and clipping.","ai_tool":"Claude"},{"repo_name":"elsa-workflows/elsa-core","commit_timestamp":"2026-10-03T17:58:14Z","branch":"main","commit_sha":"e07d2e3a3502c24611c8272cd3e2cb25a00f9ed5","github_link":"https://github.com/elsa-workflows/elsa-core/commit/e07d2e3a3502c24611c8272cd3e2cb25a00f9ed5","commit_subject":"fix(studio): scope permission refresh and make cache generation atomic","ai_tool":"Cursor"},{"repo_name":"StoDevX/AAO-React-Native","commit_timestamp":"2026-10-03T17:58:07Z","branch":"master","commit_sha":"1641c94b1a5adda5804ef88578557b3cedbc6a9c","github_link":"https://github.com/StoDevX/AAO-React-Native/commit/1641c94b1a5adda5804ef88578557b3cedbc6a9c","commit_subject":"Put feedback and email first on Contributing, and credit KRLX","ai_tool":"Claude"},{"repo_name":"ClickHouse/ClickHouse","commit_timestamp":"2026-10-03T17:58:04Z","branch":"master","commit_sha":"9862cd9565404c213c28bbc977b92b7ff822ab8e","github_link":"https://github.com/ClickHouse/ClickHouse/commit/9862cd9565404c213c28bbc977b92b7ff822ab8e","commit_subject":"Pin each coordinate check of pointInPolygon ray casting and qualify the documented exception","ai_tool":"Claude"},{"repo_name":"tannergooding/RyuJitSharp","commit_timestamp":"2026-10-03T17:57:41Z","branch":"main","commit_sha":"cbbd1374c344a1b2556408c2b439587edd2502ee","github_link":"https://github.com/tannergooding/RyuJitSharp/commit/cbbd1374c344a1b2556408c2b439587edd2502ee","commit_subject":"Record scope-name stub retirement","ai_tool":"Copilot"},{"repo_name":"jinja2cpp/Jinja2Cpp","commit_timestamp":"2026-10-03T17:57:40Z","branch":"master","commit_sha":"2a1939ccd74c2079bc9490c3a63e19dec855eadb","github_link":"https://github.com/jinja2cpp/Jinja2Cpp/