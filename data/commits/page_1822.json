[{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-10-30T11:12:19Z","branch":"main","commit_sha":"4f0dd46e21cdda870a123d2e083097b1fe9c41a8","github_link":"https://github.com/andremichelle/openDAW/commit/4f0dd46e21cdda870a123d2e083097b1fe9c41a8","commit_subject":"Recording places takes where the engine rendered them. A loop take now ends at the engine's own wrap, so every lap becomes a take even in a hidden tab, and a recording finishes when the engine stops, also without an animation frame. MIDI notes land where they were heard instead of about 33 ms late (#491) and keep their length through a main-thread block (#492); Firefox stamps on another clock and is converted. An armed audio input no longer runs about 24 ms late after another input opened, a permission was requested or the context paused: every recording reads the stream through a fresh source node. Capture IO sits behind ports in core/src/io, and scripts/capture-audit records MIDI over a virtual cable and audio through BlackHole to check it all without a person.","ai_tool":"Claude"},{"repo_name":"wonderwhy-er/DesktopCommanderMCP","commit_timestamp":"2026-10-30T11:12:15Z","branch":"main","commit_sha":"8b6a8fde17dc01b8151de0aed47cd3ac65e76937","github_link":"https://github.com/wonderwhy-er/DesktopCommanderMCP/commit/8b6a8fde17dc01b8151de0aed47cd3ac65e76937","commit_subject":"test(ci): a text-check mode: each claim in a PR's text against the change and the results files (failing first)","ai_tool":"Claude"},{"repo_name":"GlotPress/GlotPress","commit_timestamp":"2026-10-30T11:12:01Z","branch":"develop","commit_sha":"d7fdad26628a25be4bc9813daa128e952a50fe0f","github_link":"https://github.com/GlotPress/GlotPress/commit/d7fdad26628a25be4bc9813daa128e952a50fe0f","commit_subject":"Show an error when a glossary's translation set or project is missing (#2137)","ai_tool":"Claude"},{"repo_name":"LoveDaisy/Lumice","commit_timestamp":"2026-10-30T11:12:00Z","branch":"main","commit_sha":"e3f3a774010af87bcafd13108