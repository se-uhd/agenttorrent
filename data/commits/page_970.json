[{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-11-02T17:45:25Z","branch":"main","commit_sha":"fd05d5bb674298d07a47b84e348c935866dad88b","github_link":"https://github.com/andremichelle/openDAW/commit/fd05d5bb674298d07a47b84e348c935866dad88b","commit_subject":"Live rooms have Follow Playback (#325). Click a name in the room status bar and choose Follow Playback to listen along: when that person plays, stops or jumps, your playback does the same, and if they are already playing you start right at their current position. The followed person shows a broadcast icon, followers a headphone icon. While following, your own record, play and stop are disabled. Following someone who follows another person follows the person at the end of that chain. Following ends with Stop Following on your own name, or when the person at the end of the chain leaves or changes, and your controls come back right away. Everyone plays the same project, so tempo changes and the loop area match, and network delay, audio output latency and the engine start time are compensated. Leaving a live room by closing or reloading the page is now noticed by the others right away instead of after about 30 seconds. The privacy policy and the manual describe the new feature.","ai_tool":"Claude"},{"repo_name":"openvax/varcode","commit_timestamp":"2026-11-02T17:45:24Z","branch":"main","commit_sha":"e3ff9acb3f7bf56fb80141596863ff94d9354c5e","github_link":"https://github.com/openvax/varcode/commit/e3ff9acb3f7bf56fb80141596863ff94d9354c5e","commit_subject":"Type VCF compression for pandas and pin stubs in lint (#682)","ai_tool":"Claude"},{"repo_name":"tenstorrent/ttnn-visualizer","commit_timestamp":"2026-11-02T17:45:06Z","branch":"dev","commit_sha":"107197967882937dc88498166fcf534fa3b9c895","github_link":"https://github.com/tenstorrent/ttnn-visualizer/commit/107197967882937dc88498166fcf534fa3b9c895","commit_subject":"Merge remote-tracking branch 'origin/dev' into feature/2156-mcp-tensor-lifetimes","ai_