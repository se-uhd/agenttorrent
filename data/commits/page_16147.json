[{"repo_name":"go-git/go-git","commit_timestamp":"2026-09-16T10:01:35Z","branch":"main","commit_sha":"138d6c23cb7c33e0a5bfaf0f3c50a77cf42304bb","github_link":"https://github.com/go-git/go-git/commit/138d6c23cb7c33e0a5bfaf0f3c50a77cf42304bb","commit_subject":"internal: url, Leave the user out of a userless SCP-like endpoint ParseSCP builds an ssh:// URL from the three components of an SCP-like endpoint, and it always set User, even when there was no user to set. net/url draws a distinction there that this erased: url.User(\"\") is an empty userinfo, not the absence of one. An endpoint of `github.com:user/repo.git` came back as `ssh://@github.com/user/repo.git` — a URL naming no user that does not parse back to itself — and every `URL.User != nil` check downstream read it as a user having been given.","ai_tool":"Claude,Codex"},{"repo_name":"IJHack/QtPass","commit_timestamp":"2026-09-16T10:01:15Z","branch":"main","commit_sha":"ea90fea6515b4fd8326a462ad21c4fec5ce1b465","github_link":"https://github.com/IJHack/QtPass/commit/ea90fea6515b4fd8326a462ad21c4fec5ce1b465","commit_subject":"Raise the declared Qt floor to 6.8, the oldest version CI builds (#1682)","ai_tool":"Claude"},{"repo_name":"dataelement/bisheng","commit_timestamp":"2026-09-16T10:00:59Z","branch":"main","commit_sha":"685a00120f3a2031c2d66c1e29bf8391489c7070","github_link":"https://github.com/dataelement/bisheng/commit/685a00120f3a2031c2d66c1e29bf8391489c7070","commit_subject":"style(client): 图片放大层与音视频播放弹窗统一为灯箱样式","ai_tool":"Claude"},{"repo_name":"dataelement/bisheng","commit_timestamp":"2026-09-16T10:00:59Z","branch":"main","commit_sha":"609645e63921eea2d678a917d501217581854534","github_link":"https://github.com/dataelement/bisheng/commit/609645e63921eea2d678a917d501217581854534","commit_subject":"style(client): 图片放大层与音视频播放弹窗统一为灯箱样式","ai_tool":"Claude"},{"repo_name":"HKUDS/LightRAG","commit_timestamp":"2026-09-16T10:00:42Z","branch":"main","commit_sha":"bc57201cbe9953cd7a701021a26f684415363825","github_link"