b78c2ad06858e5838","github_link":"https://github.com/ClickHouse/ClickHouse/commit/771b56e7659af018098edd3b78c2ad06858e5838","commit_subject":"Drop the blank lines left where the helpers were removed","ai_tool":"Claude"},{"repo_name":"JasperFx/wolverine","commit_timestamp":"2026-09-29T13:05:43Z","branch":"main","commit_sha":"d3c5cfd2666b727981a3b027674138897c204a19","github_link":"https://github.com/JasperFx/wolverine/commit/d3c5cfd2666b727981a3b027674138897c204a19","commit_subject":"GH-4666: scheduled-message listings carry the envelope's tenant (#4667)","ai_tool":"Claude"},{"repo_name":"go-git/go-git","commit_timestamp":"2026-09-29T13:05:40Z","branch":"main","commit_sha":"30ecfc3d23f27afd502565d537f9762c718393f8","github_link":"https://github.com/go-git/go-git/commit/30ecfc3d23f27afd502565d537f9762c718393f8","commit_subject":"storage: filesystem/dotgit, Keep packed-refs records verbatim when packing. PackRefs re-encoded every existing packed entry through a lenient parser, so an ID it could not parse was written back as the zero ID, and it dropped the peeled lines git records for annotated tags. With the rewrite of an unsorted file that has no loose refs to pack, that turned a safe no-op into a corrupting one. Keep each existing record, a reference line and its peeled lines, verbatim instead: a packed loose reference replaces the record of the same name, the first of repeated names is kept, and a peeled line with no reference before it is rejected, as git rejects it.","ai_tool":"Claude"},{"repo_name":"langchain-ai/langchain","commit_timestamp":"2026-09-29T13:05:37Z","branch":"master","commit_sha":"ce9066138d0e234109ac7dd60a10ad7cc10cdfda","github_link":"https://github.com/langchain-ai/langchain/commit/ce9066138d0e234109ac7dd60a10ad7cc10cdfda","commit_subject":"fix(anthropic): support Claude Sonnet 5.5 compatibility (#40882)","ai_tool":"Open SWE"}]