[{"repo_name":"vpnhood/VpnHood","commit_timestamp":"2026-11-04T23:58:15Z","branch":"develop","commit_sha":"7eaf7908d609a484252a582a158ae87d2dc103cd","github_link":"https://github.com/vpnhood/VpnHood/commit/7eaf7908d609a484252a582a158ae87d2dc103cd","commit_subject":"TV: the UI fits the screen at any size. A TV layout is drawn for 960x540, but a TV's own layout size is not that everywhere: tvOS lays out in points, 1920x1080, and an Android TV's size comes from a density its maker chose, so a set could show the UI at half its size (1920x1080 dp), the Apple TV's fault on the owner's 4K TV, or with so few dp that the phone's layout took over and was cut off. TvScreenFit scales the view by the screen's size on every TV, replacing tvOS's fixed 2x; a browser driving a TV stays as it was. Checked on the Android TV emulator at densities 160, 240, 320, 480 and 640, the same picture at each, and on the Apple TV simulator at full size.","ai_tool":"Claude"},{"repo_name":"exo-explore/exo","commit_timestamp":"2026-11-04T23:58:06Z","branch":"main","commit_sha":"3070ad27bbac64d7060fa1b44dddc736933441e4","github_link":"https://github.com/exo-explore/exo/commit/3070ad27bbac64d7060fa1b44dddc736933441e4","commit_subject":"test(worker): wait for a cancellation to reach the runner's channel (#2595)","ai_tool":"Claude"},{"repo_name":"mattlorimor/ProbabilisticDataStructures","commit_timestamp":"2026-11-04T23:58:04Z","branch":"master","commit_sha":"f32e438dfe5aaca4b1d7415596c8d4e4b35c68ed","github_link":"https://github.com/mattlorimor/ProbabilisticDataStructures/commit/f32e438dfe5aaca4b1d7415596c8d4e4b35c68ed","commit_subject":"Hold a payload writer to refusing a run or block below nought (red)","ai_tool":"Claude"},{"repo_name":"rvdbreemen/OTGW-firmware","commit_timestamp":"2026-11-04T23:57:59Z","branch":"dev","commit_sha":"7da80113e3b481a5ee1cd87bcf18055a358a92a3","github_link":"https://github.com/rvdbreemen/OTGW-firmware/commit/7da80113e3b481a5ee1cd87bcf18055a358a92a3","commit_subject":"doc