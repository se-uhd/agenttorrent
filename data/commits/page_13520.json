[{"repo_name":"coin-or/SHOT","commit_timestamp":"2026-09-26T10:40:50Z","branch":"master","commit_sha":"4a4b54d084bf21d1a94d345f2d4689604a4479cc","github_link":"https://github.com/coin-or/SHOT/commit/4a4b54d084bf21d1a94d345f2d4689604a4479cc","commit_subject":"Add the linear terms of fixed quadratic variables at once - copyQuadraticTerms turns a quadratic term with one fixed variable into a   linear term, and added it with LinearConstraint::add(term), which merges   the term by searching every term already in the constraint. A dense   quadratic row of mostly fixed variables was therefore quadratic in the   number of terms of the row - The terms are collected and added with one bulk add, which merges them   through a hash map in one pass, so the terms and their order are the same   as before - The constraint is kept from the loop instead of being looked up again   after it, where the exception of a missing one is already handled - The corresponding loop for the objective function is unchanged:   LinearObjectiveFunction::add(term) pushes the term back without searching,   and a bulk add there would merge the terms, which is a change in behavior","ai_tool":"Claude"},{"repo_name":"kizuna-ai-lab/sokuji","commit_timestamp":"2026-09-26T10:40:49Z","branch":"main","commit_sha":"e7cf101d5cb37e9c3432b5540130c2c8270e4a15","github_link":"https://github.com/kizuna-ai-lab/sokuji/commit/e7cf101d5cb37e9c3432b5540130c2c8270e4a15","commit_subject":"feat(session): the start gate runs live, so Start says why before it is pressed","ai_tool":"Claude"},{"repo_name":"patrickchugh/terravision","commit_timestamp":"2026-09-26T10:40:43Z","branch":"main","commit_sha":"a4c7edc32662fd0077339a4eebdd8ff61e795ad6","github_link":"https://github.com/patrickchugh/terravision/commit/a4c7edc32662fd0077339a4eebdd8ff61e795ad6","commit_subject":"fix(mcp): give the diagram view a content-hashed URI so hosts reload it","ai_tool":"Claude"},{"repo_name":"capitec/dsp-decision-engine","commit_timestamp":"2026-09-26T