it_sha":"c0b0fa9cad617553b2ea363600bab6189bb3a172","github_link":"https://github.com/onnxsim/onnxsim/commit/c0b0fa9cad617553b2ea363600bab6189bb3a172","commit_subject":"axera pulsar-free: layout 8 -- the whole Qwen3 layer as one program (31 executes, card 56 -> 47 ms)","ai_tool":"Claude"},{"repo_name":"karatelabs/karate","commit_timestamp":"2026-10-27T11:17:47Z","branch":"main","commit_sha":"9a43c97a7bc96c2c61cd1186992ad339bdc8a99b","github_link":"https://github.com/karatelabs/karate/commit/9a43c97a7bc96c2c61cd1186992ad339bdc8a99b","commit_subject":"karate-core: HttpClient.abort() is sticky for the call it races. An abort() landing between the caller's last check and ApacheHttpClient publishing its request saw no current request and did nothing, so the call ran to completion; abort() now records the intent before reading the current request, and invoke() aborts its request right after publishing it when the intent is set (both volatile, so one side always sees the other); the intent clears when that call ends. A package-private beforeAssign seam runs just before the request is published. ApacheHttpClientAbortTest.abortBeforeTheRequestIsAssignedStillAbortsIt (failing first): an abort from the seam fails the call with no request reaching the stub server, and the next call runs. karate-core -Dtest='*Http*,*Abort*' 199/199.","ai_tool":"Claude"},{"repo_name":"epilot-dev/sdk-js","commit_timestamp":"2026-10-27T11:17:17Z","branch":"main","commit_sha":"a09cac2dd709619d1133be199f6d5f15250b3d97","github_link":"https://github.com/epilot-dev/sdk-js/commit/a09cac2dd709619d1133be199f6d5f15250b3d97","commit_subject":"feat(email-settings-client): excluded_senders on the auto-link setting","ai_tool":"Claude"},{"repo_name":"nodetool-ai/nodetool","commit_timestamp":"2026-10-27T11:17:10Z","branch":"main","commit_sha":"534c1090a5b394fb8d6a73fb57349755ba62e49e","github_link":"https://github.com/nodetool-ai/nodetool/commit/534c1090a5b394fb8d6a73fb57349755ba62e49e","commit_subject":"test: close crash-corpus gaps in graph-validation","ai_tool":"Claude"},{"repo_name":"qtdmm/QtDMM","commit_timestamp":"2026-10-27T11:17:04Z","branch":"master","commit_sha":"5608177eb252356c20fed0de94ef5c6480b83d0c","github_link":"https://github.com/qtdmm/QtDMM/commit/5608177eb252356c20fed0de94ef5c6480b83d0c","commit_subject":"compile.sh: another Qt from QTDMM_QT_DIR; CMake prints the Qt version","ai_tool":"Claude"},{"repo_name":"huggingface/transformers","commit_timestamp":"2026-10-27T11:16:48Z","branch":"main","commit_sha":"820b15380937a71486815cf786a3503e9b73df05","github_link":"https://github.com/huggingface/transformers/commit/820b15380937a71486815cf786a3503e9b73df05","commit_subject":"Rename only MiniMax-M3-VL's MoE block, so a save keeps the dense and vision mlp keys (#49786)","ai_tool":"Claude"},{"repo_name":"ryzom/ryzomcore","commit_timestamp":"2026-10-27T11:16:46Z","branch":"core4","commit_sha":"48b09b0042df3fcdc53cad33f09ca4a0ae77e7a0","github_link":"https://github.com/ryzom/ryzomcore/commit/48b09b0042df3fcdc53cad33f09ca4a0ae77e7a0","commit_subject":"nel: isNetworkOrDevicePath's comment ends its sentence, and its parameter is used off Windows","ai_tool":"Claude"},{"repo_name":"ryzom/ryzomcore","commit_timestamp":"2026-10-27T11:16:45Z","branch":"core4","commit_sha":"c06f2734cd61ec8466dfe547847f96a99f697791","github_link":"https://github.com/ryzom/ryzomcore/commit/c06f2734cd61ec8466dfe547847f96a99f697791","commit_subject":"nelgui: a refused or empty image download leaves no temporary file and no stale cache entry","ai_tool":"Claude"},{"repo_name":"ryzom/ryzomcore","commit_timestamp":"2026-10-27T11:16:45Z","branch":"core4","commit_sha":"663cee4f32257475cb108114ae7d4daa76f4447a","github_link":"https://github.com/ryzom/ryzomcore/commit/663cee4f32257475cb108114ae7d4daa76f4447a","commit_subject":"nelgui: a download is out of the queue before its callback runs","ai_tool":"Claude"},{"repo_name":"karatelabs/karate","commit_timestamp":"2026-10-27T11:16:39Z","branch":"main","commit_sha":"a7a7e2fa2b1b364530c7f8c7916768d611371dd4","github_link":"https://github.com/karatelabs/karate/commit/a7a7e2fa2b1b364530c7f8c7916768d611371dd4","commit_subject":"karate-js: an awaited rejection keeps the host's Java exception as the cause. A JavaCallable that threw inside an async function became a JS Error carrying the exception as its Java cause, but the uncaught-throw conversion at the program boundary (Interpreter.errorAsException) built the EngineException with no cause, so a host could not recognize its own exception type through an await; the JsError's Java cause is now the EngineException's cause. A JS catch still sees an ordinary Error. JsPromiseTest.testAwaitedRejectionKeepsTheJavaExceptionAsCause (failing first: direct and nested awaits). karate-js 1879/1879 (2 skipped).","ai_tool":"Claude"},{"repo_name":"LedgerHQ/ledger-live","commit_timestamp":"2026-10-27T11:16:38Z","branch":"develop","commit_sha":"456f6987887dcf954f8208bcff206f9d71861072","github_link":"https://github.com/LedgerHQ/ledger-live/commit/456f6987887dcf954f8208bcff206f9d71861072","commit_subject":"chore(renovate): skip coin modules updates","ai_tool":"Claude"},{"repo_name":"jinja2cpp/Jinja2Cpp","commit_timestamp":"2026-10-27T11:16:35Z","branch":"master","commit_sha":"1b849c072bf926bd47df4872aafc2f6d7f8aa9ee","github_link":"https://github.com/jinja2cpp/Jinja2Cpp/commit/1b849c072bf926bd47df4872aafc2f6d7f8aa9ee","commit_subject":"Frozen cells are collectable; the D7 back-edge walk goes (0331)","ai_tool":"Claude"},{"repo_name":"onnxsim/onnxsim","commit_timestamp":"2026-10-27T11:16:34Z","branch":"master","commit_sha":"4fd30f4b25e6d4e80ce17dc90f470606bb0a2074","github_link":"https://github.com/onnxsim/onnxsim/commit/4fd30f4b25e6d4e80ce17dc90f470606bb0a2074","commit_subject":"Merge pull request #2249 from onnxsim/claude/pf-D-ident","ai_tool":"Claude"},{"repo_name":"FOGProject/fogproject","commit_timestamp":"2026-10-27T11:16:14Z","branch":"stable","commit_sha":"d4eafcb91e0c5cbf7e63c0009b8