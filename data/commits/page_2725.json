[{"repo_name":"karatelabs/karate","commit_timestamp":"2026-10-28T05:38:01Z","branch":"main","commit_sha":"44f566f28303782e266fb176f9e6c55b5015bdce","github_link":"https://github.com/karatelabs/karate/commit/44f566f28303782e266fb176f9e6c55b5015bdce","commit_subject":"karate-core: path keeps ':' '@' and sub-delims raw, as v1 did. getUri() joined path segments with httpcore5's URIBuilder.setPathSegments, whose default policy percent-encodes everything but unreserved, so path 'users/john@example.com/items:search' went out as john%40example.com/items%3Asearch (v1's httpclient 4.5 URIBuilder left RFC 3986 pchar raw), and appending any path re-encoded the url's own path the same way. HttpUtils.encodePathSegment keeps unreserved, sub-delims, ':' and '@' and encodes every other UTF-8 byte ('/', '?', '#', '%', '[', ']', space, non-ASCII); getUri() assembles the path from it and takes scheme, authority, query and fragment from the builder as before, so query encoding is unchanged (RFC_3986 policy was not an option: it leaves '&' raw in param values). HttpRequestBuilderUriTest (11) and StepHttpTest.testPathKeepsPcharRaw (failing first: the pchar, url-path-preserved and path-plus-params cases). karate-core 2953/0/0 (3 skipped), AwsSigV4 tests included.","ai_tool":"Claude"},{"repo_name":"logto-io/logto","commit_timestamp":"2026-10-28T05:37:59Z","branch":"master","commit_sha":"f0217e47e5471def79198ca7fb81f446c630a43d","github_link":"https://github.com/logto-io/logto/commit/f0217e47e5471def79198ca7fb81f446c630a43d","commit_subject":"fix(experience): pin ios and safari floors in build target (#9845)","ai_tool":"Amp"},{"repo_name":"logto-io/logto","commit_timestamp":"2026-10-28T05:37:45Z","branch":"master","commit_sha":"ac32be2a445d0ef382a911bad9a96d6f1eb69c1d","github_link":"https://github.com/logto-io/logto/commit/ac32be2a445d0ef382a911bad9a96d6f1eb69c1d","commit_subject":"fix(console): wrap long resource names in role scopes transfer (#9841)","ai_tool":"Amp"},{"repo_name":"salilab