[{"repo_name":"go-git/go-git","commit_timestamp":"2026-04-14T22:06:58Z","branch":"main","commit_sha":"c37bc6fddb9e6924d4d2c431b7b2462369ccae15","github_link":"https://github.com/go-git/go-git/commit/c37bc6fddb9e6924d4d2c431b7b2462369ccae15","commit_subject":"plumbing: format/packfile, use ReadAt in FSObject.Reader() for concurrency safety. Replace Seek+Read with io.SectionReader backed by ReadAt in FSObject.Reader(). ReadAt does not modify the file's seek cursor (it maps to pread(2) on POSIX), so multiple goroutines can safely call Reader() on FSObjects that share the same packfile handle. The billy.File interface already requires io.ReaderAt, and both osfs (via os.File) and memfs implementations are documented as safe for concurrent ReadAt calls.","ai_tool":"Claude,Cursor"},{"repo_name":"AudiusProject/apps","commit_timestamp":"2026-04-14T22:06:41Z","branch":"main","commit_sha":"7a3f11f1dfe210f2c058e78f22f1d515fb88c035","github_link":"https://github.com/AudiusProject/apps/commit/7a3f11f1dfe210f2c058e78f22f1d515fb88c035","commit_subject":"Fix profile header collapse behavior and end-reached detection (#14107)","ai_tool":"Claude"},{"repo_name":"xh/hoist-react","commit_timestamp":"2026-04-14T22:06:34Z","branch":"develop","commit_sha":"61caac781465adc1d6d82f5d944f18dee4a3acc0","github_link":"https://github.com/xh/hoist-react/commit/61caac781465adc1d6d82f5d944f18dee4a3acc0","commit_subject":"Add client-side span sampling to TraceService (#4328)","ai_tool":"Claude"},{"repo_name":"flox/flox","commit_timestamp":"2026-04-14T22:06:24Z","branch":"main","commit_sha":"e920a9385dc4931a20fca56be2a49c1b661f3078","github_link":"https://github.com/flox/flox/commit/e920a9385dc4931a20fca56be2a49c1b661f3078","commit_subject":"feat(auth): add git transport authentication via Credential","ai_tool":"Claude"},{"repo_name":"dgunning/edgartools","commit_timestamp":"2026-04-14T22:06:15Z","branch":"main","commit_sha":"e2562b2e1be17bd05d4cacea2148333178c2855b","github_link":"https://github.com/d