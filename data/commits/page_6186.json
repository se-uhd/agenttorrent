[{"repo_name":"TeamHypersomnia/Hypersomnia","commit_timestamp":"2026-10-18T00:37:35Z","branch":"master","commit_sha":"9588a6aa68d7e94b107bdd434efad40b7fe7376c","github_link":"https://github.com/TeamHypersomnia/Hypersomnia/commit/9588a6aa68d7e94b107bdd434efad40b7fe7376c","commit_subject":"run-map skill: any map from the CLI for a test - run_map.sh (a dedicated server on an official, downloaded or edited map, BOTS=1, a spectator, visible or no client, KEEP=1, SERVER_EXTRA, LOG_GREP) and map_copy.py (a renamed copy with JSON edits), with the pitfalls hit: symlinked maps don't load, a copy named like an existing map is shadowed by it, bots play only with a human connected, PROGRESSIVE difficulty by default. local-testing's bots_match.sh is a wrapper of it.","ai_tool":"Claude"},{"repo_name":"TeamHypersomnia/Hypersomnia","commit_timestamp":"2026-10-18T00:37:35Z","branch":"master","commit_sha":"ab75af33ebe5ea8bc768e048047fdcb546c90e9e","github_link":"https://github.com/TeamHypersomnia/Hypersomnia/commit/ab75af33ebe5ea8bc768e048047fdcb546c90e9e","commit_subject":"Bots with a sniper rifle (Hunter, Bulldup, Awka: invariants::gun::bot_aim_settle_secs 0.3) fire their first shot only after seeing the target that long - before, a hard bot killed at once. The settle drains over bot_aim_settle_drain_secs (1.5) after losing the target, so a quick re-peek waits shorter; easier bots settle longer and forget faster (x1 hard, x1.5 medium, x2 easy, x3 very easy). Outside combat, missions and buying, a bot with room for one more firearm runs for the nearest one lying within a screen around it (ai_behavior_retrieve_item, searched once a second spread by the bot's index, at once again when another bot grabs it first; an unreachable one is given up on) - e.g. on fy_iceworld, where nobody spawns in a buy zone. A map may limit which firearms the shop sells (game_modes.bomb_defusal.shop_allowed_firearms in its JSON, empty for all) - the buy menu, the server and the bots' purchases all follow it.","ai_tool":"Claude"},{"repo_name":"webdriverio/webdriverio","commit_timestamp":"2026-10-18T00:37:31Z","branch":"main","commit_sha":"eebbd1b01489cfcae8784fe14e821f35b980a375","github_link":"https://github.com/webdriverio/webdriverio/commit/eebbd1b01489cfcae8784fe14e821f35b980a375","commit_subject":"fix(@wdio/utils): name the WebdriverIO attempt in a Mocha timeout error (#16124)","ai_tool":"Claude"},{"repo_name":"TeamHypersomnia/Hypersomnia","commit_timestamp":"2026-10-18T00:37:21Z","branch":"master","commit_sha":"859dcef375f9257ec16cb6ba4369527d564ec043","github_link":"https://github.com/TeamHypersomnia/Hypersomnia/commit/859dcef375f9257ec16cb6ba4369527d564ec043","commit_subject":"Melee hits push items lying on the ground again - since the knockout drops (eaf917232) no impact moved a lying item, so a knife only made the hit sound. Explosions and bullets still leave lying items in place.","ai_tool":"Claude"},{"repo_name":"mono/SkiaSharp","commit_timestamp":"2026-10-18T00:37:12Z","branch":"main","commit_sha":"66bcd1174df53e49f79d0978c889cd6e2b79ab0f","github_link":"https://github.com/mono/SkiaSharp/commit/66bcd1174df53e49f79d0978c889cd6e2b79ab0f","commit_subject":"docs: regenerate API diffs and release notes (#5389)","ai_tool":"Copilot"},{"repo_name":"mono/SkiaSharp","commit_timestamp":"2026-10-18T00:36:57Z","branch":"main","commit_sha":"471f33ca6cb8a75ed24ce687848c5eeb0ff255db","github_link":"https://github.com/mono/SkiaSharp/commit/471f33ca6cb8a75ed24ce687848c5eeb0ff255db","commit_subject":"Allow sample HTTP requests thirty seconds to complete (#5386)","ai_tool":"Copilot"},{"repo_name":"Hylozoic/hylo","commit_timestamp":"2026-10-18T00:36:47Z","branch":"dev","commit_sha":"fbb5d77c87d15a5f17f707db537eb2d766e8c1cc","github_link":"https://github.com/Hylozoic/hylo/commit/fbb5d77c87d15a5f17f707db537eb2d766e8c1cc","commit_subject":"Merge branch 'dev' into 1257-public-listing-request-tracker","ai_tool":"Claude"},{"repo_name":"moq-dev/moq","commit_timestamp":"2026-10-18T00: