[{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-11-02T08:49:15Z","branch":"main","commit_sha":"0aa4db2d853bd4c0dae2041ae9b75754d824230e","github_link":"https://github.com/andremichelle/openDAW/commit/0aa4db2d853bd4c0dae2041ae9b75754d824230e","commit_subject":"Nano gets Mono/Poly, Pan, One-Shot and Fixed pitch (#467). A new Play section holds Root, the Mono/Poly switch, Fixed and Shot, and a Mix section holds Volume and Pan. Mono fades the sounding note out in 5 ms when a new note starts. Pan follows the same law as the Playfield slot and the mixer, gliding over 5 ms. One-Shot ignores the note-off and plays to the end of the region, a looping note still stops on note-off. Fixed plays every key at the root pitch, Octave and Tune still apply. A choke from a choke group fades every voice out in 5 ms. When all 64 voices sound, a new note replaces the oldest instead of being dropped. Lowering the release while a note fades out no longer produces a single loud click. These close the gaps for Nano to take over the Playfield slot player later. Existing projects keep their sound: the new settings default to Poly, centred, gated and following the keys, and only a project with more than 64 Nano notes sounding at once plays differently.","ai_tool":"Claude"},{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-11-02T08:49:15Z","branch":"main","commit_sha":"187fde85ae3548549cc55c6f051160d253c3b4a9","github_link":"https://github.com/andremichelle/openDAW/commit/187fde85ae3548549cc55c6f051160d253c3b4a9","commit_subject":"Double-clicking an entry in the device browser selects and applies it, like pressing Ok.","ai_tool":"Claude"},{"repo_name":"hiero-ledger/hiero-sdk-js","commit_timestamp":"2026-11-02T08:49:11Z","branch":"main","commit_sha":"9af1e5f88cf7aaff2394662291e9031852a30b96","github_link":"https://github.com/hiero-ledger/hiero-sdk-js/commit/9af1e5f88cf7aaff2394662291e9031852a30b96","commit_subject":"test: add unit tests for TokenRelationship (#4316)","a