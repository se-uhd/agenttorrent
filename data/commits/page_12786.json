rksapi","commit_timestamp":"2026-09-28T21:37:11Z","branch":"main","commit_sha":"77324deb0fd4b88186e34790e1861c37bf97913b","github_link":"https://github.com/ThemeParks/parksapi/commit/77324deb0fd4b88186e34790e1861c37bf97913b","commit_subject":"refactor(sixflags): keep recordParkDateTime beside the other stamp helper","ai_tool":"Claude"},{"repo_name":"MatterHackers/agg-sharp","commit_timestamp":"2026-09-28T21:37:04Z","branch":"main","commit_sha":"6632dbfec9dd1883b89a132edf99ec2eae5cce34","github_link":"https://github.com/MatterHackers/agg-sharp/commit/6632dbfec9dd1883b89a132edf99ec2eae5cce34","commit_subject":"A GPU gradient fill reads a colour function's float colours when it has them: one that is also an IColorFunctionFloat is written to a half-float table, encoded to sRGB without rounding to bytes, so the shader's decode gives back its linear light. The compositing demo's gradients offer theirs, and color-burn, which divides by the rounded rectangle's near-black end (0x05 is 0.0015 linear), now matches the float window within 3 levels like every other operator - it was 19 levels off at opaque alphas and 5 at translucent ones. CompositingDemoTests drops its color-burn exception.","ai_tool":"Claude"},{"repo_name":"CopilotKit/CopilotKit","commit_timestamp":"2026-09-28T21:36:39Z","branch":"main","commit_sha":"305f8153ffdfe1cde79c1f03b91ef010101f9c0f","github_link":"https://github.com/CopilotKit/CopilotKit/commit/305f8153ffdfe1cde79c1f03b91ef010101f9c0f","commit_subject":"fix(reskinnable-demo): address CodeRabbit review on tenant memory governance","ai_tool":"Claude"}]