[{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-11-01T20:34:33Z","branch":"main","commit_sha":"f238b54207fb0b2f06895fd57a3f1a83f6e6a8fe","github_link":"https://github.com/andremichelle/openDAW/commit/f238b54207fb0b2f06895fd57a3f1a83f6e6a8fe","commit_subject":"A WebCLAP plugin's first notes after a stop sound again. The check whether a plugin ignored its reset judged the first block after it; when that block already played (play pressed right after the stop) or brought notes, the new note counted as a tail, the block was muted and the restart dropped the note (Pro54 missed notes on the first play). Only a quiet block (transport stopped, no events, no input) is judged now, any other drops the check.","ai_tool":"Claude"},{"repo_name":"andremichelle/openDAW","commit_timestamp":"2026-11-01T20:34:33Z","branch":"main","commit_sha":"f41aad0a0d618879671e6f0d9148f9b8b5f68b75","github_link":"https://github.com/andremichelle/openDAW/commit/f41aad0a0d618879671e6f0d9148f9b8b5f68b75","commit_subject":"The WebCLAP update also moves user presets to the newer builds and names what keeps an old build. A preset holding a WebCLAP device kept its old build in use, so the deletion skipped it and the update bubble never went. Presets are rewritten like projects (their header kept, the device reading its state); an old build still in use after the update is listed with its users in a dialog.","ai_tool":"Claude"},{"repo_name":"zunath/SWLOR_NWN","commit_timestamp":"2026-11-01T20:34:21Z","branch":"master","commit_sha":"69b8083be2c64e63606472546866ee3f0636f7ef","github_link":"https://github.com/zunath/SWLOR_NWN/commit/69b8083be2c64e63606472546866ee3f0636f7ef","commit_subject":"Capstone dungeons: one faction each, shared skill-proof targets, tiers by depth (#3080)","ai_tool":"Claude"},{"repo_name":"openfootmanager/openfootmanager","commit_timestamp":"2026-11-01T20:34:15Z","branch":"develop","commit_sha":"0c570af9cfe41df4222db1b001af254256ceb5ec","github_link":"https://github.com/o