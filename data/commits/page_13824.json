[{"repo_name":"lowdefy/lowdefy","commit_timestamp":"2026-09-27T07:30:18Z","branch":"main","commit_sha":"59162f75890c87bc5dced1dfd24c569987c52f23","github_link":"https://github.com/lowdefy/lowdefy/commit/59162f75890c87bc5dced1dfd24c569987c52f23","commit_subject":"fix(connection-mongodb): Declare the packages the auth adapter imports","ai_tool":"Claude"},{"repo_name":"lowdefy/lowdefy","commit_timestamp":"2026-09-27T07:30:18Z","branch":"main","commit_sha":"37e124cd054bd71aafca4d49ed98aa2d36a1af50","github_link":"https://github.com/lowdefy/lowdefy/commit/37e124cd054bd71aafca4d49ed98aa2d36a1af50","commit_subject":"test: Worktree bootstrap script, testing guide and worktree-safe block e2e ports","ai_tool":"Claude"},{"repo_name":"MatterHackers/agg-sharp","commit_timestamp":"2026-09-27T07:29:57Z","branch":"main","commit_sha":"cb97c4cc167770cc2a62884703c47a0366ea3816","github_link":"https://github.com/MatterHackers/agg-sharp/commit/cb97c4cc167770cc2a62884703c47a0366ea3816","commit_subject":"A device can opt in to the adapter's compute limits (raiseComputeLimits on the constructor and CreateAsync): it requests the adapter's maxBufferSize, maxStorageBufferBindingSize, maxStorageBuffersPerShaderStage and maxComputeInvocationsPerWorkgroup, falling back to the defaults if refused; render-only hosts are unchanged. AdapterLimits reports what the adapter supports, and DeviceLimits gains MaxStorageBuffersPerShaderStage, MaxUniformBufferBindingSize and the storage and uniform offset alignments. Bind groups on both the real and recording devices now refuse a buffer range over the binding-size limit, misaligned, or past the buffer's end (BindGroupValidation) instead of wgpu-native aborting the process at dispatch; the refusal is pinned in a child-process probe. On an Apple M5 the opt-in grants 14 GB buffers, 4 GB storage bindings, 31 storage buffers per stage and 1024 invocations per workgroup.","ai_tool":"Claude"},{"repo_name":"ClickHouse/ClickHouse","commit_timestamp":"2026-09-27T07:2