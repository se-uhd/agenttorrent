, depth, list style or alignment changed, so list children moved by an edit redraw at their new indent.","ai_tool":"Claude"},{"repo_name":"microsoft/vscode","commit_timestamp":"2026-10-01T19:13:41Z","branch":"main","commit_sha":"7f5f0d251f64939a04b25f3b362daed3f29e58bf","github_link":"https://github.com/microsoft/vscode/commit/7f5f0d251f64939a04b25f3b362daed3f29e58bf","commit_subject":"editor: align connected tab geometry across wrapped states (#339028)","ai_tool":"Copilot"},{"repo_name":"dashpay/dash-evo-tool","commit_timestamp":"2026-10-01T19:13:33Z","branch":"v1.0-dev","commit_sha":"104c55418db170cb181d7c5d7dfbf292f64a6c08","github_link":"https://github.com/dashpay/dash-evo-tool/commit/104c55418db170cb181d7c5d7dfbf292f64a6c08","commit_subject":"fix(identity): explain missing wallet secret on signing and restore data from previous version (#1040)","ai_tool":"Claude"},{"repo_name":"bloxbean/cardano-client-lib","commit_timestamp":"2026-10-01T19:13:15Z","branch":"master","commit_sha":"d5ccf5be2a3ac66d883cd1ba10a1755d82db4cf9","github_link":"https://github.com/bloxbean/cardano-client-lib/commit/d5ccf5be2a3ac66d883cd1ba10a1755d82db4cf9","commit_subject":"review(plutus): keep every byte-string key over 64 bytes, read the indefinite tag-102 form, bounded fast path for encode (#681)","ai_tool":"Claude"},{"repo_name":"ClickHouse/ClickHouse","commit_timestamp":"2026-10-01T19:13:08Z","branch":"master","commit_sha":"daa6165d5641987adeb2f3ea25608eafa96fb1bb","github_link":"https://github.com/ClickHouse/ClickHouse/commit/daa6165d5641987adeb2f3ea25608eafa96fb1bb","commit_subject":"Do not dereference a null logs_queue in OwnSplitChannel::log","ai_tool":"Claude"},{"repo_name":"bendlang/bend","commit_timestamp":"2026-10-01T19:13:05Z","branch":"main","commit_sha":"0443100f3be0b383c44ba8fd2287dd991e36c2dd","github_link":"https://github.com/bendlang/bend/commit/0443100f3be0b383c44ba8fd2287dd991e36c2dd","commit_subject":"The emitted C builds at -O0: segments take preserve_none only whe