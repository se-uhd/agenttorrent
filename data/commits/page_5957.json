 desyncs, 100-200 knocks in 4 minutes; de_cyberaqua at 128: no extra fixtures, no knocks.","ai_tool":"Claude"},{"repo_name":"GMOD/jbrowse-components","commit_timestamp":"2026-10-18T20:19:07Z","branch":"main","commit_sha":"b88fbcf161dccdfaa72bf4cc08b59a457329a7c2","github_link":"https://github.com/GMOD/jbrowse-components/commit/b88fbcf161dccdfaa72bf4cc08b59a457329a7c2","commit_subject":"LinearSyntenyView: thin the row-loc comments","ai_tool":"Claude"},{"repo_name":"lowdefy/lowdefy","commit_timestamp":"2026-10-18T20:19:04Z","branch":"main","commit_sha":"51fd6f03dcf1851b3e391563005bb5718784c39e","github_link":"https://github.com/lowdefy/lowdefy/commit/51fd6f03dcf1851b3e391563005bb5718784c39e","commit_subject":"feat(blocks-native): Add the SegmentedControl block","ai_tool":"Claude"},{"repo_name":"lowdefy/lowdefy","commit_timestamp":"2026-10-18T20:19:04Z","branch":"main","commit_sha":"9b7ba6a1de8f7e0741a665e4e2f4588ae503a726","github_link":"https://github.com/lowdefy/lowdefy/commit/9b7ba6a1de8f7e0741a665e4e2f4588ae503a726","commit_subject":"feat(blocks-native): Add shared native menu, system icon and avatar helpers","ai_tool":"Claude"},{"repo_name":"ShapeCrawler/ShapeCrawler","commit_timestamp":"2026-10-18T20:18:46Z","branch":"master","commit_sha":"e8fce923d227fe2e981b1d5743dfceba69574b28","github_link":"https://github.com/ShapeCrawler/ShapeCrawler/commit/e8fce923d227fe2e981b1d5743dfceba69574b28","commit_subject":"Merge pull request #1343 from ShapeCrawler/codex/rea-text-highlighting","ai_tool":"Codex"},{"repo_name":"TriliumNext/Trilium","commit_timestamp":"2026-10-18T20:18:32Z","branch":"main","commit_sha":"c58e9d78799255cacd38a504b0204c0d61a68e65","github_link":"https://github.com/TriliumNext/Trilium/commit/c58e9d78799255cacd38a504b0204c0d61a68e65","commit_subject":"fix(attributes): delete the confirmed rows after a reload or note change","ai_tool":"Claude"},{"repo_name":"pandas-dev/pandas","commit_timestamp":"2026-10-18T20:18:31Z","branch":"main","commit_sha":"a802be8