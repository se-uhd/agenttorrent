[{"repo_name":"vpnhood/VpnHood","commit_timestamp":"2026-10-13T23:11:56Z","branch":"develop","commit_sha":"3f8e4707bfbd78bf87e48c6681851ffca137cfc4","github_link":"https://github.com/vpnhood/VpnHood/commit/3f8e4707bfbd78bf87e48c6681851ffca137cfc4","commit_subject":"TcpStack: loss recovery at segment granularity - a retransmission (fast or RTO) opens a NewReno-style recovery in which each partial ACK retransmits the next lost segment at once and further duplicate ACKs retransmit nothing, a writer blocked on a full retransmit ring waits for the RTO instead of probing every 200 ms, a zero window counts as flow control (probe ACKs are not duplicate ACKs, an RTO under a zero window ends the recovery), a partial ACK at the FIN retransmits the FIN, the ACK path's sends are guarded, the delayed-ACK flush is 50 ms to stay under a Linux or Android peer's 200 ms minimum RTO; a dropped 64 KB window recovers in about 2 s instead of 44 s; 8 regression tests (Opus max review taken)","ai_tool":"Claude"},{"repo_name":"dotnet/sdk","commit_timestamp":"2026-10-13T23:11:46Z","branch":"main","commit_sha":"abe2b5db8fa5f23df3bb26a8b0da8fcd27c80f53","github_link":"https://github.com/dotnet/sdk/commit/abe2b5db8fa5f23df3bb26a8b0da8fcd27c80f53","commit_subject":"Update stable branding runtime version features","ai_tool":"Copilot"},{"repo_name":"mattgodbolt/jsbeeb","commit_timestamp":"2026-10-13T23:11:45Z","branch":"main","commit_sha":"19524f618852138fef91898700ee2a4e1e5792cc","github_link":"https://github.com/mattgodbolt/jsbeeb/commit/19524f618852138fef91898700ee2a4e1e5792cc","commit_subject":"fix: go to a symbol's name typed in the debugger's Addr or Mem addr box, and stay put on anything else (#1265)","ai_tool":"Claude"},{"repo_name":"nodetool-ai/nodetool","commit_timestamp":"2026-10-13T23:11:40Z","branch":"main","commit_sha":"a818a79587f6bbd83d1fb5718a5cf6855426897a","github_link":"https://github.com/nodetool-ai/nodetool/commit/a818a79587f6bbd83d1fb5718a5cf6855426897a","commit_subject":"Mer