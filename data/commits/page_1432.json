[{"repo_name":"vpnhood/VpnHood","commit_timestamp":"2026-10-31T18:12:09Z","branch":"develop","commit_sha":"7c3e0d73110ae3627cc260c1331d2894c6941ade","github_link":"https://github.com/vpnhood/VpnHood/commit/7c3e0d73110ae3627cc260c1331d2894c6941ade","commit_subject":"Android: the VPN connects on Android 7.0 to 8.1 again. .NET 11's SslStream asks Android for the handshake's cipher before it calls our certificate check: Android 7's own TLS answers \"(NONE)\", which .NET cannot parse, so no connect got through, and Android 8.1's crashes the process (dotnet/runtime#136272 avoids only that one, on main). Below Android 9 the VPN service now puts Conscrypt 2.8.0 first among the TLS providers (AndroidTlsProvider), whose handshake answers it; it brings no trust manager on Android, so the network security config still decides the trust. Release builds connected on Android 7.0, 7.1, 8.0 and 8.1 against a local server; about 1 MB compressed per ABI","ai_tool":"Claude"},{"repo_name":"vimeo/psalm","commit_timestamp":"2026-10-31T18:11:55Z","branch":"master","commit_sha":"3c2bd23bf174439c6726f2ac4eaa289786b810d3","github_link":"https://github.com/vimeo/psalm/commit/3c2bd23bf174439c6726f2ac4eaa289786b810d3","commit_subject":"docs: document @psalm-stub-override #10041","ai_tool":"Claude"},{"repo_name":"jhipster/generator-jhipster","commit_timestamp":"2026-10-31T18:11:52Z","branch":"main","commit_sha":"d63f54abba716348c75856bf3352a0f59a2c2b05","github_link":"https://github.com/jhipster/generator-jhipster/commit/d63f54abba716348c75856bf3352a0f59a2c2b05","commit_subject":"test(knative): register the mssql microservice with Helm at its cluster address on port 80 in the snapshot (#35909)","ai_tool":"Claude"},{"repo_name":"neinteractiveliterature/intercode","commit_timestamp":"2026-10-31T18:11:46Z","branch":"main","commit_sha":"c0a5ad47834c15324718317744a0b11edc1462ba","github_link":"https://github.com/neinteractiveliterature/intercode/commit/c0a5ad47834c15324718317744a0b11edc1462ba","commit