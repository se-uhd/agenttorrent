[{"repo_name":"elizaOS/eliza","commit_timestamp":"2026-07-11T06:31:58Z","branch":"develop","commit_sha":"3a28dc9de46b4df0acf9f23b4b1579d3c40ed99f","github_link":"https://github.com/elizaOS/eliza/commit/3a28dc9de46b4df0acf9f23b4b1579d3c40ed99f","commit_subject":"test(ui): complete OAuth launch module boundary","ai_tool":"Claude"},{"repo_name":"hclivess/nado","commit_timestamp":"2026-07-11T06:31:52Z","branch":"main","commit_sha":"0bd4eccb82f67a7dffcde4becb2a698e29c3d4eb","github_link":"https://github.com/hclivess/nado/commit/0bd4eccb82f67a7dffcde4becb2a698e29c3d4eb","commit_subject":"background signing: REUSE one persistent signer iframe instead of booting a fresh wallet per call. The SDK now loads the wallet ONCE in a hidden ?bgsvc=1 iframe, waits for a nadoBgReady ping, then streams every sign request over postMessage (serialised via a queue) — so the ~1s wallet/crypto boot is paid once per game page, not on every move/spin/settle. The wallet installs a persistent message handler that reuses the exact same decide+sign path, and a BGSVC guard keeps the hidden signer lean: NO mining (would've been a duplicate miner in an invisible iframe), no dashboard, no pollers. Robust fallback preserved: service never readies (framing blocked) → 12s → redirect everything; request times out → redirect; locked/needs-confirm → redirect + learned _bgOff/_bgValueUI so later calls skip straight to it.","ai_tool":"Claude"},{"repo_name":"strawlab/strand-braid","commit_timestamp":"2026-07-11T06:28:48Z","branch":"main","commit_sha":"597f641a149b605b7f193ec4e7ac33e4217dd883","github_link":"https://github.com/strawlab/strand-braid/commit/597f641a149b605b7f193ec4e7ac33e4217dd883","commit_subject":"fix(flydra2): anchor fake sync to the frame clock, not packet arrival order (Claude Fable 5)","ai_tool":"Claude"},{"repo_name":"sebastienros/jint","commit_timestamp":"2026-07-11T06:28:13Z","branch":"main","commit_sha":"463157397d25e29735c37e9dbc89a752791f95b4","github_link":"https://github.com/sebastienros/jint/commit/463157397d25e29735c37e9dbc89a752791f95b4","commit_subject":"Refresh engine comparison benchmark results (#2629)","ai_tool":"Claude"},{"repo_name":"elizaOS/eliza","commit_timestamp":"2026-07-11T06:27:52Z","branch":"develop","commit_sha":"147aa63644c9e680abf15cf6e6b896a3c10b96fb","github_link":"https://github.com/elizaOS/eliza/commit/147aa63644c9e680abf15cf6e6b896a3c10b96fb","commit_subject":"chore: retrigger CI with current PR title/body","ai_tool":"Claude"},{"repo_name":"hajimehoshi/ebiten","commit_timestamp":"2026-07-11T06:26:16Z","branch":"main","commit_sha":"61b3555734a24809ae74f675d2654a72966ae6f4","github_link":"https://github.com/hajimehoshi/ebiten/commit/61b3555734a24809ae74f675d2654a72966ae6f4","commit_subject":"text/v2/internal/oksvg: handle errors flagged by errcheck","ai_tool":"Claude"},{"repo_name":"nebulastream/nautilus","commit_timestamp":"2026-07-11T06:25:52Z","branch":"main","commit_sha":"c09b79bc5c261b11391ade6645269483e8be9b23","github_link":"https://github.com/nebulastream/nautilus/commit/c09b79bc5c261b11391ade6645269483e8be9b23","commit_subject":"Skip no-op block argument prep in C++ backend (#394)","ai_tool":"Claude"},{"repo_name":"hclivess/nado","commit_timestamp":"2026-07-11T06:25:40Z","branch":"main","commit_sha":"430d4e9fb7fc5cdeaf91d0e149ad7703902d5506","github_link":"https://github.com/hclivess/nado/commit/430d4e9fb7fc5cdeaf91d0e149ad7703902d5506","commit_subject":"pets: FIX eggs that won't hatch — hatch/rebirth passed the pid as-is, but when you pick an egg from the grid the pid is a STRING (el.dataset.pet). The contract computes gene = HASH(bh0 + bh1 + pid), and that '+ pid' is arithmetic, so a string pid hits the VM's int type-gate → 'expected int' → revert (no-op). Every other pets call already coerces Number(pid); hatch and rebirth were the only two that didn't. Diagnosed from the live exec log (645867…hatch by ndo27f2870bb… -> revert (no-op), repeatedly) and reproduced against the real egg storage: hatch([239444704]) ok=True, hatch(['239444704']) reverts. randId is 1..1e9 so Number() is always lossless. Both stuck eggs now hatch in the harness","ai_tool":"Claude"},{"repo_name":"dcSpark/cddl-codegen","commit_timestamp":"2026-07-11T06:25:20Z","branch":"master","commit_sha":"cf70a612f4b1425accd455fed1bb10b8756c841d","github_link":"https://github.com/dcSpark/cddl-codegen/commit/cf70a612f4b1425accd455fed1bb10b8756c841d","commit_subject":"harden comment preservation against generator-emitted comments and duplicate statements","ai_tool":"Claude"},{"repo_name":"elizaOS/eliza","commit_timestamp":"2026-07-11T06:24:45Z","branch":"develop","commit_sha":"386236be8559c4b9a03e78b74b4995a3258ef60b","github_link":"https://github.com/elizaOS/eliza/commit/386236be8559c4b9a03e78b74b4995a3258ef60b","commit_subject":"test(app-core): cover local JSONL usage counters","ai_tool":"Claude"},{"repo_name":"EvotecIT/OfficeIMO","commit_timestamp":"2026-07-11T06:24:14Z","branch":"master","commit_sha":"d2b8cf89c2ede33b0bb5904de14faab04625383b","github_link":"https://github.com/EvotecIT/OfficeIMO/commit/d2b8cf89c2ede33b0bb5904de14faab04625383b","commit_subject":"Merge pull request #2051 from EvotecIT/codex/reader-processor-pipeline","ai_tool":"Codex"},{"repo_name":"nilsteampassnet/TeamPass","commit_timestamp":"2026-07-11T06:23:28Z","branch":"master","commit_sha":"afc83f0f57ca42b7127db80f73734baa4c392397","github_link":"https://github.com/nilsteampassnet/TeamPass/commit/afc83f0f57ca42b7127db80f73734baa4c392397","commit_subject":"Fix access matrix report: read roles from users_roles join table","ai_tool":"Claude"},{"repo_name":"finol-digital/Card-Game-Simulator","commit_timestamp":"2026-07-11T06:21:41Z","branch":"main","commit_sha":"034997b34e98d05f43945da1e953ba2d54a06a92","github_link":"https://github.com/finol-digital/Card-Game-Simulator/commit/034997b34e98d05f43945da1e953ba2d54a06a92","commit_subject":"Potential fix for pull request finding","ai_tool":"Copilot"},{"repo_name":"elizaOS/eliza","commit_timestam