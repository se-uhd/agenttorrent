[{"repo_name":"Inkaengine/inka","commit_timestamp":"2026-10-31T18:20:56Z","branch":"main","commit_sha":"59122dada7e3615c9396a01bc4570b3207e00a06","github_link":"https://github.com/Inkaengine/inka/commit/59122dada7e3615c9396a01bc4570b3207e00a06","commit_subject":"MCP: every new item of a list of objects gets the id its field names (#598)","ai_tool":"Claude"},{"repo_name":"qelectrotech/qelectrotech-source-mirror","commit_timestamp":"2026-10-31T18:20:44Z","branch":"master","commit_sha":"0de313858b095d5e85bd61527a3fb02a830502d5","github_link":"https://github.com/qelectrotech/qelectrotech-source-mirror/commit/0de313858b095d5e85bd61527a3fb02a830502d5","commit_subject":"Fix #1662: keep cell sizes when switching paper size back and forth","ai_tool":"Claude"},{"repo_name":"TeamHypersomnia/Hypersomnia","commit_timestamp":"2026-10-31T18:20:26Z","branch":"master","commit_sha":"a078463d369365e5f6399c6aa625f961d2d2fbec","github_link":"https://github.com/TeamHypersomnia/Hypersomnia/commit/a078463d369365e5f6399c6aa625f961d2d2fbec","commit_subject":"Rendering on a thread of its own, the window on the main thread (src/application/main/gl_thread.h). The main thread only takes the window's messages and applies what the game wants of the window (settings, cursor), sleeping in between; the GL thread executes the renderer's commands, swaps and trades buffers with the logic, taking whatever input came so far - a slow message pump (e.g. a mouse hook on Windows making every mouse message cost ~1 ms) no longer stalls frames. Vsync only from the thread that renders (window::apply_vsync); the X11 backend calls XInitThreads and really releases its GLX context; Windows waits for messages with MsgWaitForMultipleObjectsEx. The web build keeps its one main loop.","ai_tool":"Claude"},{"repo_name":"phucvinh57/biopass","commit_timestamp":"2026-10-31T18:20:04Z","branch":"main","commit_sha":"2561514e7854671e7104e91567913a722a6c583c","github_link":"https://github.com/phucvinh57/biopass/commit/2561514e7854