[{"repo_name":"yvanvds/yse-soundengine","commit_timestamp":"2026-10-23T22:59:44Z","branch":"dev","commit_sha":"716a4dd321a86679b9a485fcaf413cbf2820e5c7","github_link":"https://github.com/yvanvds/yse-soundengine/commit/716a4dd321a86679b9a485fcaf413cbf2820e5c7","commit_subject":"feat(patcher): ~cartopol ~poltocar ~phasewrap (#1053)","ai_tool":"Claude"},{"repo_name":"amd/gaia","commit_timestamp":"2026-10-23T22:59:43Z","branch":"main","commit_sha":"776c10a4c72d347cd7fef06f454f53d9a3591a7f","github_link":"https://github.com/amd/gaia/commit/776c10a4c72d347cd7fef06f454f53d9a3591a7f","commit_subject":"chore(deps): bump Lemonade Server to v2026.43.3 (#5558)","ai_tool":"Claude"},{"repo_name":"vpnhood/VpnHood","commit_timestamp":"2026-10-23T22:59:42Z","branch":"develop","commit_sha":"479dbd313a029c8bbf5d44a02d898ddd64f3a5c9","github_link":"https://github.com/vpnhood/VpnHood/commit/479dbd313a029c8bbf5d44a02d898ddd64f3a5c9","commit_subject":"Packets: an IPv6 packet reads through its Hop-by-Hop, Destination Options, AH and Fragment headers, so Protocol, Header and Payload name the TCP, UDP or ICMP header behind them, and it stops at a Routing header, whose final destination the upper layer's checksum covers; a packet without extension headers pays one check. IsFragment on both versions: no piece of a fragmented datagram is extracted as its TCP, UDP or ICMP packet, UpdateAllChecksums updates only a fragment's IPv4 header checksum (it wrote a checksum into a later piece's data), IsIcmpEcho is false for one, and the channel manager sends fragments on its first channel, as its pick by port threw on UDP fragments. Server: NetProtector drops fragments and IPv6 packets stopped at an extension header before their ports are read - a client could send DNS or SYNs behind a Hop-by-Hop header past its session's limits, while the kernel reads through it","ai_tool":"Claude"},{"repo_name":"OliveTin/OliveTin","commit_timestamp":"2026-10-23T22:59:39Z","branch":"main","commit_sha":"add4f1c545820dc7