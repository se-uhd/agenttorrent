aterfall.max's UV controller now decodes as KEYFRAMER keys=2 range=[0..16000]). Also: --uvgen-dump gains per-chunk sizes (the probe that pinned the key layout).","ai_tool":"Claude"},{"repo_name":"cozystack/cozystack","commit_timestamp":"2026-07-07T08:52:17Z","branch":"main","commit_sha":"60704530ed62e2fd7d3ded2fe9d0ea96e7eb277a","github_link":"https://github.com/cozystack/cozystack/commit/60704530ed62e2fd7d3ded2fe9d0ea96e7eb277a","commit_subject":"docs(security): align security docs with current controls for incubation DD","ai_tool":"Claude"},{"repo_name":"xoriors/rencfs","commit_timestamp":"2026-07-07T08:52:14Z","branch":"main","commit_sha":"6e0cc9f8732f591129e003861aa8418cd1f72f35","github_link":"https://github.com/xoriors/rencfs/commit/6e0cc9f8732f591129e003861aa8418cd1f72f35","commit_subject":"fix(cli): dispatch passwd subcommand to run_change_password","ai_tool":"Claude"},{"repo_name":"zwave-js/zwave-js","commit_timestamp":"2026-07-07T08:51:53Z","branch":"master","commit_sha":"4a7e6dc1f73e82374e1806a762254063f4b59d69","github_link":"https://github.com/zwave-js/zwave-js/commit/4a7e6dc1f73e82374e1806a762254063f4b59d69","commit_subject":"perf(test): parallelize integration tests, avoid unnecessary timeouts (#8935)","ai_tool":"Claude"},{"repo_name":"vxcontrol/pentagi","commit_timestamp":"2026-07-07T08:51:48Z","branch":"main","commit_sha":"1ef56d19722176a494042edb9b2b830571f2accf","github_link":"https://github.com/vxcontrol/pentagi/commit/1ef56d19722176a494042edb9b2b830571f2accf","commit_subject":"refactor(forms): migrate FlowForm to useAppForm","ai_tool":"Claude"},{"repo_name":"TulevaEE/onboarding-service","commit_timestamp":"2026-07-07T08:51:41Z","branch":"master","commit_sha":"2de681e4bb468da7b9ebf0f9cd7ad8e97fa4de51","github_link":"https://github.com/TulevaEE/onboarding-service/commit/2de681e4bb468da7b9ebf0f9cd7ad8e97fa4de51","commit_subject":"Alert and mark R45 incomplete on unknown transaction type or unmapped ISIN","ai_tool":"Claude"}]