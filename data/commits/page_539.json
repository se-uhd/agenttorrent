[{"repo_name":"MUnique/OpenMU","commit_timestamp":"2026-11-03T19:20:35Z","branch":"master","commit_sha":"727b40d6478a7499d59d133b40bd00dbf3b8b3a4","github_link":"https://github.com/MUnique/OpenMU/commit/727b40d6478a7499d59d133b40bd00dbf3b8b3a4","commit_subject":"Merge branch 'new1401' into claude/serene-brown-mkqsjd","ai_tool":"Claude"},{"repo_name":"vpnhood/VpnHood","commit_timestamp":"2026-11-03T19:20:16Z","branch":"develop","commit_sha":"a97a2891d1d0c6f75adbc8c02626f6760f6e33b8","github_link":"https://github.com/vpnhood/VpnHood/commit/a97a2891d1d0c6f75adbc8c02626f6760f6e33b8","commit_subject":"Tunnel MTU: a tunnel carries packets of up to 1400 bytes both ways, where it dropped every packet over 1280, which broke Steam's games (#782): Valve's relays take UDP payloads of up to 1300 bytes, and Dota 2 could ping none of them. The MTU is now the packet as it is: Tunnel.VerifyMtu no longer adds the 120-byte overhead estimate to a limit that already keeps 100 bytes for it (MtuClient, 1500 - 100), and its ICMP reply names the real limit. The server holds a session to the smaller of MtuClient and the client's MTU, as its UDP channel carries no more in one datagram (1433 bytes; 1461 with IPv4, 1481 with IPv6), and sends it in HelloResponse.TunnelMtu; the client's adapter and tunnel take it, or the old 1280 from a server that sends none. Packets still share a datagram only up to 1380 bytes, as before. In Dota 2 on a Windows 11 VM: through 9.1.864 every region's ping failed, as in the issue; through this build every region pinged, and a lobby match on Valve's server ran through its relays.","ai_tool":"Claude"},{"repo_name":"GMOD/jbrowse-components","commit_timestamp":"2026-11-03T19:20:12Z","branch":"main","commit_sha":"e37c2ac2c4a3876ec46955311a55b981b655d9e6","github_link":"https://github.com/GMOD/jbrowse-components/commit/e37c2ac2c4a3876ec46955311a55b981b655d9e6","commit_subject":"Multi-row guide: a config writing its own marks writes rows too","ai_tool":"Claude"},{"repo_n