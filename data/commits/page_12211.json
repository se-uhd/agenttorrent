":"Claude"},{"repo_name":"mlflow-oidc/mlflow-oidc-auth","commit_timestamp":"2026-10-01T18:46:23Z","branch":"main","commit_sha":"00ecebe90aad3d87b64c4846d34075ebe64daaf4","github_link":"https://github.com/mlflow-oidc/mlflow-oidc-auth/commit/00ecebe90aad3d87b64c4846d34075ebe64daaf4","commit_subject":"fix(auth): keep health probes unprotected under MLflow static prefix (#442)","ai_tool":"Claude"},{"repo_name":"mitodl/ol-data-platform","commit_timestamp":"2026-10-01T18:46:09Z","branch":"main","commit_sha":"e8360c12705992281458af0581e1ba0fa743a661","github_link":"https://github.com/mitodl/ol-data-platform/commit/e8360c12705992281458af0581e1ba0fa743a661","commit_subject":"chore(inventory): retire the Airbyte-loaded edX catalog tables (#2792)","ai_tool":"Claude"},{"repo_name":"jdeast/EXOZIPPy","commit_timestamp":"2026-10-01T18:45:58Z","branch":"master","commit_sha":"db50db968f48960ae87b85610ba71c6d7bac4b92","github_link":"https://github.com/jdeast/EXOZIPPy/commit/db50db968f48960ae87b85610ba71c6d7bac4b92","commit_subject":"ob09020 integration: probe once per run, thin 40x, force the gate (7.13.9)","ai_tool":"Claude"},{"repo_name":"grafana/grafana","commit_timestamp":"2026-10-01T18:45:48Z","branch":"main","commit_sha":"a6e60f8c99725700e721d867358a36c549b685cc","github_link":"https://github.com/grafana/grafana/commit/a6e60f8c99725700e721d867358a36c549b685cc","commit_subject":"Auth: Bound OAuth token refresh lock waits by time instead of attempts (#133929)","ai_tool":"Cursor"},{"repo_name":"pulp/pulp_python","commit_timestamp":"2026-10-01T18:45:47Z","branch":"main","commit_sha":"f598a5fef175bb39236d72f1da0ba9bf6e464264","github_link":"https://github.com/pulp/pulp_python/commit/f598a5fef175bb39236d72f1da0ba9bf6e464264","commit_subject":"Bump bandersnatch to 8.0","ai_tool":"Codex"},{"repo_name":"DataDog/build-plugins","commit_timestamp":"2026-10-01T18:45:43Z","branch":"master","commit_sha":"46c4454911857e45da967dd4654a45d2dc0f3961","github_link":"https://github.com/DataDog/build